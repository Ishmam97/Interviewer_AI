rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: caller must be the authenticated owner of the document
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // User profiles — owner only
    match /profiles/{uid} {
      allow read, write: if isOwner(uid);
    }

    // User settings — owner may read; only the backend (Admin SDK, which
    // bypasses these rules) writes. Holds plan and *_this_month usage
    // counters, so client writes would let a user reset their own quota.
    match /user_settings/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Beta waitlist — written straight from the public landing site (no
    // backend). Create-only with validated fields; nobody can list, read,
    // update or delete through the client SDK. Doc ID must equal
    // sha256(email): binds the ID to its email, so nobody can squat another
    // address's slot or store one email under many IDs. A repeat signup is an
    // update and is rejected (the client treats that as "already on the list").
    match /beta_signups/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'consent', 'created_at'])
        && request.resource.data.keys().hasAll(['email', 'consent', 'created_at'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[a-z0-9.!#$%&\'*+/=?^_`{|}~-]+@[a-z0-9-]+(\\.[a-z0-9-]+)+$')
        && request.resource.data.consent == true
        && request.resource.data.created_at == request.time
        && id == hashing.sha256(request.resource.data.email).toHexString().lower();
    }

    // Interview sessions — owner only
    match /interview_sessions/{sessionId} {
      allow read, write: if request.auth != null
        && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid;
    }

    // Interview reports — owner only
    match /interview_reports/{reportId} {
      allow read, write: if request.auth != null
        && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
